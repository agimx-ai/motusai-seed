# Seed Cloud discovery trust. The public key is a Base64-encoded SPKI DER value.
MOTUSAI_SEED_CLOUD_URL=https://cloud.motusseed.com
MOTUSAI_DISTRIBUTION_KEY_ID=motusai-cloud-production-v1
MOTUSAI_DISTRIBUTION_PUBLIC_KEY=MCowBQYDK2VwAyEAGhcDBccJ1TtieZrAO1YFMs7sL7s7JuvtKPJFB7BheTc=

# Only enable this for a loopback or private IPv4 development service.
MOTUSAI_ALLOW_INSECURE_HTTP=false

# Packaging target. These values are only read by electron-builder.
MOTUSAI_UPDATE_CHANNEL=stable
MOTUSAI_RELEASE_PLATFORM=mac-arm64

# Optional local diagnostics. Never enable this in a normal production build.
# MOTUSAI_PLUGIN_HOST_DEBUG=true

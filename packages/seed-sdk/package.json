{
  "name": "@motus-ai/seed-sdk",
  "version": "0.3.2",
  "description": "Public runtime, shared UI and development tools for MotusAI Seed plugins",
  "type": "commonjs",
  "license": "UNLICENSED",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./dist/theme.css",
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.js"
    },
    ".": {
      "types": "./dist/browser.d.ts",
      "browser": "./dist/browser.js",
      "node": "./dist/index.js",
      "default": "./dist/browser.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.js"
    },
    "./tools": {
      "node": {
        "types": "./dist/tools/index.d.mts",
        "default": "./dist/tools/index.mjs"
      }
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json && node scripts/prepare-dist.mjs && node scripts/build-styles.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "streamdown": "^2.6.0",
    "react-i18next": "^17.0.12",
    "typescript": "7.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "lucide-react": "^0.468.0"
  },
  "peerDependencies": {
    "streamdown": "^2.6.0",
    "react-i18next": "^17.0.12",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.468.0"
  },
  "peerDependenciesMeta": {
    "streamdown": {
      "optional": true
    },
    "react-i18next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@types/node": "^24.0.0",
    "i18next": "^26.4.0",
    "sonner": "^2.0.8",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "tailwindcss": "4.3.3",
    "archiver": "^8.0.0",
    "esbuild": "^0.28.2",
    "driver.js": "1.10.2"
  },
  "bin": {
    "seed-plugin": "dist/tools/cli.mjs"
  }
}
